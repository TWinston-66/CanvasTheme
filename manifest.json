{
  "manifest_version": 2,
  "name": "Canvas One Dark Pro",
  "version": "1.0.8",
  "description": "An authentic One Dark Pro dark theme for Canvas LMS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-one-dark-pro@winston.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "browser_action": {
    "default_title": "Canvas Theme Settings",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "*://*.colorado.edu/*",
    "*://*.instructure.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.colorado.edu/*",
        "*://*.instructure.com/*"
      ],
      "css": [
        "content/theme.css"
      ],
      "js": [
        "shared/defaults.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
